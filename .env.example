# MLOps / modelo
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT=credit-risk-default
# Descomenta para servir el modelo desde el Model Registry de MLflow en vez
# del artefacto local (requiere un modelo ya promovido a "Production"):
# MLFLOW_MODEL_URI=models:/bcp_credit_xgboost/Production
MODEL_PATH=data/processed/model.joblib
# Umbral de rechazo. El código usa 0.5 si no se define, pero con una
# prevalencia de default de 6.7 % ese valor solo detecta ~20 % de los
# defaults. 0.16 minimiza el costo esperado con costo FN:FP = 5:1 (ver
# "Umbral de decisión" en el README y `python -m src.ml.evaluation`).
DECISION_THRESHOLD=0.16

# Monitoreo continuo y reentrenamiento automático
DRIFT_PSI_THRESHOLD=0.2
PERFORMANCE_AUC_DROP_THRESHOLD=0.05
