POSTGRES_DB=credit_risk
POSTGRES_USER=credit_risk
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://credit_risk:change_me@localhost:5432/credit_risk

# MLOps / modelo
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT=credit-risk-default
# Descomenta para servir el modelo desde el Model Registry de MLflow en vez
# del artefacto local (requiere un modelo ya promovido a "Production"):
# MLFLOW_MODEL_URI=models:/bcp_credit_xgboost/Production
MODEL_PATH=data/processed/model.joblib
DECISION_THRESHOLD=0.5

# Monitoreo continuo y reentrenamiento automático (src/orchestrator/monitor.py)
DRIFT_PSI_THRESHOLD=0.2
PERFORMANCE_AUC_DROP_THRESHOLD=0.05
MONITORING_CRON=0 * * * *

# Fase 0: seguridad de la API (ver docs del proyecto / arquitectura híbrida)
# Clave requerida en la cabecera X-API-Key para /predict, /outcomes y
# /monitoring/status (y para /docs, /redoc si DOCS_ENABLED=true). Si se deja
# vacía, se genera una clave temporal en cada arranque y se registra en el
# log — cómodo para probar localmente, pero define un valor fijo aquí antes
# de desplegar.
API_KEY=
# Orígenes permitidos por CORS, separados por coma (vacío = ninguno).
CORS_ORIGINS=http://localhost:8501
# Límite de requests por cliente, sintaxis de slowapi.
RATE_LIMIT=60/minute
# Sirve /docs y /redoc (protegidos por API_KEY). En false, ni siquiera se
# montan las rutas.
DOCS_ENABLED=true

# Entrena un modelo automáticamente al arrancar si no hay ningún artefacto
# en MODEL_PATH (ver src/ml/bootstrap.py) -- pensado para un despliegue
# "clone-and-run" como Render, donde el modelo no está commiteado a git.
# En local normalmente se deja en false.
AUTO_TRAIN_MODEL=false
# URL pública de la API, usada solo por app.py (Streamlit) para armar el
# botón "Ver Documentación API (Swagger)" -- en local es el valor por
# defecto; en Render, la URL pública del servicio de la API.
API_PUBLIC_URL=http://127.0.0.1:8000
