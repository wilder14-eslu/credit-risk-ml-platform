# Copia a .env (nunca lo subas a Git). Usado por el gateway local y la CLI.
DATABRICKS_HOST=https://<tu-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi-xxxxxxxx
DATABRICKS_WAREHOUSE_ID=<id-del-sql-warehouse>

# Gateway
SERVING_BACKEND=local          # local | databricks
LOG_SINK=sqlite                # sqlite | databricks | memory
SERVING_ENDPOINT=credit-risk-endpoint
UC_CATALOG=workspace
UC_SCHEMA=credit_risk_dev
API_KEYS=dev-key-cambiar

# Streamlit
API_URL=http://localhost:8000
API_KEY=dev-key-cambiar
